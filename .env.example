# =============================================================================
# LINK VAULT BACKEND - ENVIRONMENT VARIABLES FOR VERCEL DEPLOYMENT
# =============================================================================
# Configure these in your Vercel Project Settings > Environment Variables:
# =============================================================================

NODE_ENV=production
PORT=3000

# Domain & Frontend Configuration
Domain=https://your-backend.vercel.app/
FRONTEND_URL=https://your-frontend.vercel.app

# MongoDB Connection String (from MongoDB Atlas)
MongoUrl=mongodb+srv://<username>:<password>@cluster0.mongodb.net/LinkVault?retryWrites=true&w=majority

# JWT Secret (Generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_super_strong_random_jwt_secret_at_least_32_characters

# Admin Portal Credentials
ADMIN_USER=admin
ADMIN_PASSWORD=your_strong_admin_password

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Google Gemini AI API Key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20
